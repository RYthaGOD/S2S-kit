  "types": [
    {
      "name": "DappRegistry",
      "docs": [
        "A registered dApp that receives the user-facing share of harvested yield.",
        "(PDA: [b\"dapp\", dapp_id])."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "dapp_id",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "treasury",
            "docs": [
              "Owner of the dApp treasury token accounts (yield is paid to its ATA)."
            ],
            "type": "pubkey"
          },
          {
            "name": "min_stake_value",
            "docs": [
              "Minimum SOL-denominated principal value required to hold this dApp's pass."
            ],
            "type": "u64"
          },
          {
            "name": "price_per_period",
            "docs": [
              "Subscription price in SOL-value lamports per `period_seconds`. 0 = unmetered",
              "(access lasts as long as the vault is open)."
            ],
            "type": "u64"
          },
          {
            "name": "period_seconds",
            "type": "i64"
          },
          {
            "name": "trial_seconds",
            "docs": [
              "Free-trial granted on first subscribe, in seconds (instant access while yield warms up)."
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "GlobalConfig",
      "docs": [
        "Protocol-wide configuration. One per deployment (PDA: [b\"global_config\"])."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "protocol_fee_bps",
            "docs": [
              "Protocol's share of harvested yield, in basis points (e.g. 300 = 3%)."
            ],
            "type": "u16"
          },
          {
            "name": "treasury",
            "docs": [
              "Owner of the protocol treasury token accounts. Payouts are sent to the",
              "associated token account of this owner for the relevant LST mint."
            ],
            "type": "pubkey"
          },
          {
            "name": "pass_mint",
            "docs": [
              "The shared Token-2022 (non-transferable) Active Pass mint."
            ],
            "type": "pubkey"
          },
          {
            "name": "cooldown_seconds",
            "docs": [
              "Seconds a vault must cool down before principal can be withdrawn."
            ],
            "type": "u64"
          },
          {
            "name": "total_dapps",
            "type": "u64"
          },
          {
            "name": "total_lsts",
            "type": "u16"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "LstConfig",
      "docs": [
        "An accepted Liquid Staking Token. One per allow-listed mint (PDA: [b\"lst\", mint]).",
        "",
        "`rate` is underlying-lamports (SOL) per 1 LST base unit, scaled by `RATE_PRECISION`.",
        "For `RATE_KIND_SPL_STAKE_POOL`, `refresh_lst_rate` derives it on-chain from the pool's",
        "`total_lamports / pool_token_supply` (trustless). `RATE_KIND_MANUAL` is for test LSTs",
        "with no real pool and is only writable by the protocol authority."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "mint",
            "type": "pubkey"
          },
          {
            "name": "rate",
            "type": "u128"
          },
          {
            "name": "rate_kind",
            "type": "u8"
          },
          {
            "name": "rate_source",
            "docs": [
              "For SPL stake-pool LSTs: the StakePool state account the rate is read from."
            ],
            "type": "pubkey"
          },
          {
            "name": "last_rate_update",
            "type": "i64"
          },
          {
            "name": "enabled",
            "type": "bool"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "UserVault",
      "docs": [
        "A user's deposit position. One per user (PDA: [b\"vault\", user]).",
        "",
        "The vault escrows a single LST. The user's *principal value* (denominated in",
        "the LST's underlying, SOL) is preserved across harvests: as the LST rate rises",
        "the vault holds more value than the principal, and the surplus LST is skimmed",
        "as yield. On withdrawal the user receives the LST still held by the vault,",
        "which is worth their original principal value at the current rate."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "lst_mint",
            "docs": [
              "The LST mint this vault holds (set on first deposit; immutable until withdraw)."
            ],
            "type": "pubkey"
          },
          {
            "name": "dapp",
            "docs": [
              "The dApp this position subscribes to (yield recipient)."
            ],
            "type": "pubkey"
          },
          {
            "name": "deposited_lst",
            "docs": [
              "LST base units currently escrowed. Decreases as yield is skimmed."
            ],
            "type": "u64"
          },
          {
            "name": "principal_value",
            "docs": [
              "SOL-lamport principal value to preserve. target_lst = principal_value * 1e12 / rate."
            ],
            "type": "u64"
          },
          {
            "name": "cumulative_yield_skimmed",
            "docs": [
              "Lifetime LST skimmed as yield (stats)."
            ],
            "type": "u64"
          },
          {
            "name": "protocol_fees_contributed",
            "docs": [
              "Lifetime LST routed to the protocol treasury from this vault (the passive-income stream)."
            ],
            "type": "u64"
          },
          {
            "name": "active_pass_mint",
            "type": "pubkey"
          },
          {
            "name": "deposited_at",
            "type": "i64"
          },
          {
            "name": "paid_through",
            "docs": [
              "Unix timestamp through which access is paid (trial + yield-funded time).",
              "`i64::MAX` for unmetered dApps. Access is active while `now <= paid_through`."
            ],
            "type": "i64"
          },
          {
            "name": "is_cooling_down",
            "type": "bool"
          },
          {
            "name": "cooldown_start_time",
            "type": "i64"
          },
          {
            "name": "last_harvest_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    }
